@@ -227,6 +228,11 @@ IOStatus TorFS::NewWritableFile(const std::string& fname,
   if (fname.find("MANIFEST") != std::string::npos) {
     pId = 4;
   }
+  // [pilot] TORFS_FORCE_PID=<n> overrides the default PID as well.
+  const char* force_pid = getenv("TORFS_FORCE_PID");
