# =====================================================================
# FDP 파일럿 설정 파일
#   - 인구(PC 보정)와 지윤(FEMU 실행)이 같은 파일을 씁니다.
#   - "★ 채울 것" 표시가 있는 줄은 각자 환경에 맞게 바꿔 주세요.
# =====================================================================

# ---------- 작업 폴더 ----------
WORK="${WORK:-$HOME/fdp_pilot_work}"          # 소스·빌드·결과가 쌓이는 곳
RESULTS="${RESULTS:-$WORK/results}"

# ---------- RocksDB / TorFS 버전 ----------
# Lan et al.과 같은 조합입니다. (Lan 저장소: RocksDB 7.2.2 + TorFS 0a6e399)
ROCKSDB_TAG="v7.2.2"
TORFS_COMMIT="0a6e399aa3df0b5cd5bbe9d9ccee09d853f3a95a"
LAN_REPO_COMMIT="HEAD"                         # sijielan/FDP_Benchmarking

# ---------- 데이터 ----------
KEY_SIZE=16                 # 바이트
VALUE_SIZE=1024             # 바이트 (Lan YCSB는 40 KB. 파일럿은 1 KB로 시작, README 참고)

# ---------- LSM 설정 ----------
# Lan의 YCSB OPTIONS 파일(OPTIONS-000009) 비율을 줄인 값입니다.
#   Lan: level_base 512 MB, target_file 64 MB, write_buffer 128 MB (= 8 : 1 : 2)
#        num_levels 6, L0 trigger 2, min_write_buffer_to_merge 2, max_write_buffer 6,
#        dynamic_level_bytes=false
LEVEL_BASE_MB=4             # L1 크기(MB). 파일·memtable 크기는 이것에서 자동 계산
LEVEL_MULT=10
NUM_LEVELS=6
L0_TRIGGER=2
MIN_WB_MERGE=2
MAX_WB_NUMBER=6
BG_JOBS=4                   # 백그라운드 flush+compaction 작업 수 (기록해 둘 값)
COMPRESSION="none"          # 쓰기량 단위가 압축률에 흔들리지 않게 끔 (Lan db_bench와 같음)

# ---------- 장치(FEMU) ----------
DEV_CAPACITY_GIB=24         # ★ 채울 것: FEMU 사용자 용량(GiB)
RU_MIB=128                  # ★ 확인: FEMU RU 크기(MiB)
NG_DEV="/dev/ng0n1"         # ★ 채울 것: FEMU 게스트 안의 문자 장치 (TorFS가 씀)
NVME_DEV="/dev/nvme0n1"     # ★ 채울 것: 같은 장치의 블록 장치 이름 (카운터 읽기용)

# FDP 격리 방식. 파일럿은 모든 RUH가 II (PI 비교는 갈래 A에서).
#   FEMU는 femu-subsys 에 fdp.isolation_mode=2 를 줘서 띄워야 해요 (이 브랜치에서 추가한 값).
#   원본의 isolation_mode=1 은 마지막 RUH만 II 라서, 데이터를 쓰는 RUH는 PI 가 돼요.
#   02_femu_run.sh 가 run 전에 'nvme fdp configs'로 PID 0 ~ NUM_PIDS-1 의 RUH 종류를 확인하고,
#   EXPECT_RUHT 와 다르면 멈춰요. any 면 확인하지 않아요.
EXPECT_RUHT="II"            # II | PI | any
NUM_PIDS=5                  # TorFS가 쓰는 PID 수 (WAL, L0–L3, L4, L5, MANIFEST)

# 목표 장치 사용률 = (삭제 대기 파일까지 포함한) 최대 사용량 / 사용자 용량
TARGET_UTILS="0.70 0.93"

# 공간 증폭(space amp) = 최대 사용량 / 논리 데이터 크기
#   ★ 인구가 01_pc_calibrate.sh 결과(두 사용률 중 큰 값)로 채웁니다. 처음엔 1.15로 두고 계산만 해 보세요.
SPACE_AMP=1.15
# 여유: 실제 계산엔 SPACE_AMP x (1 + SPACE_MARGIN)을 써요.
#   측정값이 정확하면 실제 최고 사용률이 목표보다 약 2% 낮게 잡혀요 (93% -> 약 91.2%).
SPACE_MARGIN=0.02

# overwrite 단계에서 쓸 양 = 논리 데이터 크기 × OVERWRITE_MULT
OVERWRITE_MULT=3
THREADS=4                   # overwrite 스레드 수 (load는 항상 1개)
SEED=1
# workload: 균등 랜덤 overwrite로 먼저 돌려요.
#   이득 무너짐이 재현되지 않으면 그다음에 zipfian(Lan의 YCSB-A처럼 일부 키에 쓰기 쏠림)을 시도해요.

# ---------- 판정 ----------
# gain = 1 - WAF_lan / WAF_single  (overwrite 뒤 1/3 기준)
MIN_GAIN_LOW=0.10           # 70%에서 gain이 이보다 작으면 판정하지 않음 (비율이 의미 없어서)
COLLAPSE_RATIO=0.5          # gain(93%) / gain(70%) 이 이보다 작으면 "무너짐"
BORDER_BAND=0.1             # 0.4~0.6 이면 경계 -> 93% 두 run을 한 번 더 (REP=2)

# ---------- 측정 ----------
SAMPLE_SEC=30               # 장치 카운터를 몇 초마다 읽을지

# 장치 카운터 읽는 방법
#   fdpstats : nvme-cli의 'nvme fdp stats' (FDP 통계 로그 페이지)를 읽음
#   custom   : 아래 COUNTER_CMD가 "host_bytes media_bytes" 두 숫자를 한 줄로 출력
COUNTER_METHOD="fdpstats"
FDP_ENDGRP=1
COUNTER_CMD=""              # ★ custom일 때 채울 것 (예: FEMU 통계를 읽는 스크립트)

# RUH(PID)별 쓰기 확인 방법
#   femu      : 이 브랜치(fdp-pilot) FEMU의 사용량 로그(vendor log C1h)를 읽음 (기본)
#               RUH별 host·media 쓰기량이 정확하게 나오고, 장치의 실제 사용률
#               (유효 데이터 / 용량)도 같이 기록돼요 (usage.csv, ruh_usage.csv)
#   fdpstatus : 'nvme fdp status'의 RUH별 남은 쓰기량(RUAMW) 변화로 추정 (Lan 방식, 실제 FDP SSD용 근사)
#               RUAMW는 LBA 단위예요 (LBA 크기는 장치에서 읽어요, 아래 LBA_BYTES).
#               샘플 사이에 RU를 두 개 넘게 쓰면 덜 세요
#   custom    : RUH_CMD가 "pid bytes" 줄들을 출력
#   none      : 안 읽음
RUH_METHOD="femu"
RUH_CMD=""
FEMU_USAGE_LID=0xc1         # femu: 사용량 로그 번호 (hw/femu/nvme.h NVME_LOG_FEMU_FDP_USAGE)
LBA_BYTES=512               # LBA 크기(B)는 run마다 'nvme id-ns'로 읽어 run 폴더의 lba_bytes 에 남겨요.
                            #   이 값은 그걸 못 읽었을 때만 써요 (FEMU 기본 512, 실제 FDP SSD는 보통 4096)

# ---------- FEMU 자동 재시작 (03_host_loop.sh, 호스트에서 씀) ----------
# run마다 FEMU를 새로 띄워 FTL을 깨끗하게 만들어요. 이 칸들은 호스트의 config.env 에만 채우면 돼요.
FEMU_START_CMD=""           # ★ 지윤: FEMU를 "앞에서(foreground)" 띄우는 명령. 예: "cd ~/femu/build-femu && ./run-fdp.sh"
GUEST_SSH=""                # ★ 지윤: 게스트 접속 주소. 예: "femu@localhost"
GUEST_SSH_OPTS="-p 8080"    # ★ 지윤: ssh 옵션 (포트 포워딩 등)
GUEST_DIR=""                # ★ 지윤: 게스트 안의 fdp_pilot 폴더 경로. 예: "/home/femu/fdp_pilot"
GUEST_PREP_CMD=""           # (선택) 부팅 뒤 run 전에 게스트에서 돌릴 명령. 예: FDP 네임스페이스 만들기
BOOT_TIMEOUT_SEC=600        # FEMU 부팅을 기다리는 최대 시간
SHUTDOWN_TIMEOUT_SEC=180    # 끄기를 기다리는 최대 시간 (넘으면 강제 종료)
POLL_SEC=60                 # run이 끝났는지 확인하는 간격
HOST_RESULTS="${HOST_RESULTS:-$HOME/fdp_pilot_results}"   # 결과를 호스트로 가져올 폴더

# 손으로 돌릴 때(02_femu_run.sh 직접 실행)만 씀: FEMU를 깨끗하게 만드는 명령.
#   비워 두면 run마다 "FEMU를 새로 띄운 뒤 Enter"를 물어봐요. 03_host_loop.sh를 쓰면 필요 없어요.
FEMU_RESET_CMD=""
